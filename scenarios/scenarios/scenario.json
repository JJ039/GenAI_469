
{
    "title": "Crisis Scenario",
    "type": "object",
    "description": "A scenario where we will test the cascade model.",
    "properties": {
        "id": { "type": "string", "description": "Unique ID, e.g. scn_001" },
        "name": { "type": "string", "description": "Human-readable, e.g. false_rumor_healthy" },
        "trigger": {
        "type": "string",
        "description": "The crisis event that starts everything — a news post, internal audit report, system alert, regulatory notice, etc."
        },
        "financials": {
        "type": "object",
        "required": ["capital", "liquidity", "borrowing_limit", "daily_withdrawals"],
        "properties": {
            "capital": { "type": "number" },
            "liquidity": { "type": "number" },
            "borrowing_limit": { "type": "number" },
            "daily_withdrawals": { "type": "number" },
            "forecast_next_7d": { "type": "number" }
        }
        },
        "regulations": {
        "type": "object",
        "required": ["max_draw_facility", "report_to_regulator"],
        "properties": {
            "max_draw_facility": { "type": "number" },
            "report_to_regulator": { "type": "boolean" },
            "max_drawal_rate_pct": { "type": "number" }
        }
        },
        "answer_key": {
        "type": "object",
        "required": ["news_label", "ideal_actions", "acceptable_actions", "forbidden_actions", "target_amount_range"],
        "properties": {
            "news_label": { "type": "string", "enum": ["credible", "false", "unverified"] },
            "ideal_actions": { "type": "array", "items": { "type": "string" } },
            "acceptable_actions": { "type": "array", "items": { "type": "string" } },
            "forbidden_actions": { "type": "array", "items": { "type": "string" } },
            "target_amount_range": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 }
        }
        }

    }
}