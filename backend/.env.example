# Copy to .env and fill in. NEVER commit real keys.
# OpenRouter: https://console.openrouter.ai → API Keys
OPENROUTER_API_KEY=
GOOGLE_API_KEY=your-key-here
GROQ_API_KEY=your-key-here

# LLM transport config (backend/.env.example)
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
LLM_TRANSPORT=openrouter
LLM_MAX_TOKENS=4096
LLM_REASONING_EFFORT=low
# Optional manual Hermes transport:
# LLM_PROVIDER=openrouter
# HERMES_EXECUTABLE=C:/Users/your-user/AppData/Local/hermes/bin/hermes.exe
