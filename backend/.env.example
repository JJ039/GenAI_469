OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Google AI Studio: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-key-here

# Groq: https://console.groq.com/keys
GROQ_API_KEY=your-key-here
