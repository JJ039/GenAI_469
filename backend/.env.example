# Local language model (install Ollama, then run: ollama pull qwen3:1.7b)
LLM_TRANSPORT=ollama
LLM_MODEL=qwen3:1.7b
LLM_MAX_TOKENS=4096
LLM_REASONING_EFFORT=low

# Hosted Qdrant collection used by Compliance RAG.
# Keep the real API key private and do not commit backend/.env.
QDRANT_URL=https://YOUR-CLUSTER-ENDPOINT
QDRANT_API_KEY=YOUR-QDRANT-API-KEY
QDRANT_COLLECTION=regulatory_corpus_v1
