# Copy to backend/.env. Do not commit your real key.
OPENROUTER_API_KEY=
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
LLM_TRANSPORT=openrouter
LLM_MAX_TOKENS=4096
LLM_REASONING_EFFORT=low
# Optional manual Hermes transport:
# LLM_PROVIDER=openrouter
# HERMES_EXECUTABLE=C:/Users/your-user/AppData/Local/hermes/bin/hermes.exe

# Local inference with an installed Ollama model:
# LLM_TRANSPORT=ollama
# LLM_MODEL=qwen3:1.7b
